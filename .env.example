# =============================================================================
# UtsavOps Environment Configuration
# Copy to .env and fill in your values
# =============================================================================

# --- Application ---
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-to-a-random-secret-key
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_URL=http://localhost:5173

# --- Database ---
# For local dev (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./utsavops.db
# For production (PostgreSQL via Google Cloud SQL):
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/utsavops

# --- Sarvam AI ---
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai

# --- Flagsmith ---
FLAGSMITH_SERVER_URL=https://edge.api.flagsmith.com/api/v1/
FLAGSMITH_ENVIRONMENT_KEY=
FLAGSMITH_API_TOKEN=

# --- Google APIs ---
GOOGLE_MAPS_API_KEY=

# --- NudgeBee ---
NUDGEBEE_API_URL=
NUDGEBEE_API_KEY=

# --- Kubernetes ---
K8S_NAMESPACE=utsavops
K8S_IN_CLUSTER=false
KUBECONFIG_PATH=

# --- Gemini (for AIOps RCA) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
