# =============================================================================
# UtsavOps Environment Configuration Template
# Copy to .env and fill in your values
# DO NOT commit .env with real credentials to source control
# =============================================================================

# --- Application ---
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-to-a-secure-random-secret
AUTH_SECRET_KEY=change-me-to-a-secure-random-32-char-secret-key
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_URL=http://localhost:5173

# --- Google Cloud & Gemini ---
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=asia-south1
GOOGLE_MAPS_AQI_ADDR_API_KEY=your-google-maps-api-key
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-flash-latest

# --- Cloud SQL PostgreSQL ---
DB_HOST=your-cloud-sql-host-ip
DB_PORT=5432
DB_NAME=utsavops
DB_USER=postgres
DB_PASSWORD=your-db-password
DATABASE_URL=postgresql://postgres:your-db-password@your-cloud-sql-host-ip:5432/utsavops

# --- Sarvam AI ---
SARVAM_API_KEY=your-sarvam-api-key
SARVAM_BASE_URL=https://api.sarvam.ai

# --- Initial Admin Provisioning (Used during db seed) ---
INITIAL_ADMIN_EMAIL=admin@utsavops.internal
INITIAL_ADMIN_PASSWORD=your-secure-admin-password-required-in-production
INITIAL_ADMIN_NAME=UtsavOps Lead SRE

# --- Flagsmith ---
# 1. SDK / Client Key: Used for evaluation against Flagsmith Edge API
FLAGSMITH_ENV_KEY=your-flagsmith-client-or-sdk-key
# 2. Management API Numeric Environment ID (e.g. 118673, from Project Settings -> Environments)
FLAGSMITH_ENVIRONMENT_ID=your-numeric-environment-id
# 3. Server-side Master/Admin API key (never shared with frontend)
FLAGSMITH_ADMIN_API_KEY=your-flagsmith-master-admin-api-key
# 4. Feature IDs for targeted versioning operations
FLAGSMITH_SURGE_MODE_FEATURE_ID=299379
FLAGSMITH_EXPRESS_DELIVERY_FEATURE_ID=299380
FLAGSMITH_SERVER_URL=https://edge.api.flagsmith.com/api/v1/

# --- NudgeBee & Kubernetes ---
NUDGEEBEE_VM_NAME=utsavops-nudgebee
NUDGEEBEE_SECRET_NAME=flagsmith_api_key
NUDGEEBEE_EXTRA_TOKEN=your-nudgebee-extra-token
NUDGEBEE_TOKEN=your-nudgebee-extra-token
K8S_NAMESPACE=utsavops
K8S_IN_CLUSTER=false
KUBECONFIG_PATH=
